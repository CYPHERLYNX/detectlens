<!--
  DetectLens seed ruleset — site-local custom rules (Wazuh 4.x style).
  Custom IDs start at 100001. Product: detectlens.
-->
<group name="local,">
  <rule id="100001" level="10">
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.image">powershell.exe</field>
    <regex>-EncodedCommand</regex>
    <description>Local: Encoded PowerShell execution detected by EDR script.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100002" level="8">
    <field name="custom.ssh_unexpected_source">yes</field>
    <description>Local: SSH login from unexpected source network.</description>
    <mitre>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <!-- Deliberately untagged: asset-inventory telemetry, no technique mapping -->
  <rule id="100003" level="5">
    <field name="custom.usb_inserted">yes</field>
    <description>Local: USB mass storage device inserted.</description>
  </rule>

  <!-- Deliberately untagged: operational health alert, no technique mapping -->
  <rule id="100004" level="7">
    <field name="custom.disk_free_pct">below_threshold</field>
    <description>Local: Disk free space below 5 percent threshold.</description>
  </rule>
</group>
